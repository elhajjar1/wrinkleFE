_parked/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
.eggs/

# Virtual environments
venv/
.venv/
env/

# Streamlit secrets (service-account keys for usage logging — NEVER commit).
# Keep the committed .streamlit/secrets.toml.example template.
.streamlit/secrets.toml

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Claude
.claude/settings.local.json
.claude/transcripts/
.claude/cache/
.claude/worktrees/

# Generated validation figures (regenerated by scripts)
figures/fig_validation_*.png

# OS
.DS_Store
Thumbs.db

# Testing
.pytest_cache/
.coverage
# Per-process data files from a parallel/subprocess coverage run, and the
# XML report both --cov CI jobs emit — running the documented
# `pytest --cov=wrinklefe --cov-report=xml` locally would otherwise leave
# them untracked in `git status`.
.coverage.*
coverage.xml
htmlcov/
.tox/
# pytest-benchmark's autosave storage, written by the documented
# `--benchmark-autosave` command. NOT the committed baseline, which lives
# at tests/test_benchmarks/baseline/ and is deliberately tracked.
.benchmarks/

# Build artifacts
*.so
*.dylib

# PyInstaller (auto-generated specs only — keep our committed Windows spec)
*.spec
!wrinklefe_windows.spec

# Release zips
WrinkleFE-*.zip

# Jupyter
.ipynb_checkpoints/

# LaTeX build files
joss/*.aux
joss/*.bbl
joss/*.blg
joss/*.log
joss/*.out
joss/*.synctex.gz
joss/*.fdb_latexmk
joss/*.fls
.superpowers/
docs/superpowers/
joss/
docs/_build/
# examples/ and validation/ hold tracked, CI-executed scripts. Only their
# *generated outputs* are ignored — via examples/.gitignore and
# validation/.gitignore — so a wholesale ignore here doesn't silently hide
# new scripts (or already-tracked reference figures) from git status
# (issue #374).

# Generated validation figures (issue #278): tests render here by default;
# set WRINKLEFE_FIGURE_DIR=figures to deliberately refresh committed evidence.
figures/_generated/
